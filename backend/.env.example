# ==========================================
# Django Core Settings
# ==========================================
SECRET_KEY=change-me-to-a-random-secure-secret-key-32-chars-min
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# count of reverse proxies in front of Django; Next.js rewrite + platform edge = 2
NUM_PROXIES=1


# ==========================================
# Database (PostgreSQL)
# ==========================================
DATABASE_URL=postgres://study_user:study_pass@localhost:5432/study_assistant

# ==========================================
# Frontend Origin & CORS
# ==========================================
FRONTEND_URL=http://localhost:3000

# ==========================================
# Authentication & Google OAuth
# ==========================================
# Public OAuth 2.0 Web Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
AUTH_COOKIE_SECURE=False
AUTH_REFRESH_COOKIE_NAME=refresh_token

# ==========================================
# AI Provider (Google Gemini / Groq / Mock)
# ==========================================
# Options: 'gemini' (Recommended), 'groq', 'mock'
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-api-key-here
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
AI_MODEL_NAME=gemini-3.5-flash
AI_MAX_PROMPT_CHARS=500000

# ==========================================
# Background Tasks (Celery & Redis)
# ==========================================
REDIS_URL=redis://:devredis@localhost:6379/0

# ==========================================
# Web Push Notifications (Optional)
# ==========================================
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CLAIM_EMAIL=mailto:support@sora.study

# ==========================================
# Email Service (Resend - Optional in local dev)
# ==========================================
# If omitted or empty, Django falls back to console email backend in dev
RESEND_API_KEY=re_your_resend_api_key
DEFAULT_FROM_EMAIL=SORA <onboarding@resend.dev>
