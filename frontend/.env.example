# ==========================================
# SORA Frontend Environment Variables
# ==========================================

# SORA Auth API URL (Fast auth endpoints)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1/auth

# SORA General Backend API URL (Documents, Flashcards, Quizzes, Tasks, Notifications)
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000/api/v1

# Google OAuth 2.0 Web Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Web Push VAPID Public Key (Generate via: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
