# ==========================================
# SORA Frontend Environment Variables
# ==========================================

# API base URLs are relative: Next.js proxies /api/v1/* to Django (same origin, FE-23).
NEXT_PUBLIC_API_URL=/api/v1/auth
NEXT_PUBLIC_BACKEND_API_URL=/api/v1

# Where the Next.js server forwards /api/v1/* (server-side only, read at build time).
# Local: http://localhost:8000   Railway: http://api.railway.internal:8000
BACKEND_INTERNAL_URL=http://localhost:8000

# Google OAuth 2.0 Web Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Web Push VAPID Public Key (Generate via: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
